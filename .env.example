# 末尾の / はあっても構いません。
MISSKEY_URL=https://misskey.example

# ローカルのモデレーターアカウント用アクセストークン。
# ユーザー確認、凍結、ロール付与の管理API権限が必要です。
MISSKEY_TOKEN=replace-with-a-moderator-token

# dry-run: Misskey変更なし（T2/T3監査キューは登録） / enforce: T1凍結とT2ロール付与も実行
AUTOMOD_MODE=dry-run

# T2で付与するMisskey手動ロールID。T2をenforceする場合は必須です。
T2_ROLE_ID=

# T2/T3をLLM監査キューへ入れるまでの遅延（既定15分）。
LLM_REVIEW_DELAY_MS=900000

# 監査台帳、遅延監査キュー、T1削除キューの永続化先。
AUTOMOD_DATA_DIR=data

# 各永続キューの最大ユニークジョブ数。到達時は安全側に停止します。
MAX_QUEUED_JOBS=100000

# 処理中を含む受信ノートの最大保持数。超過時はノートIDのみを警告ログに残します。
MAX_PENDING_NOTES=1000

HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787

# 将来のT1削除ワーカー用の操作間隔。現在のリアルタイム処理では未使用です。
MIN_ACTION_INTERVAL_MS=1100
