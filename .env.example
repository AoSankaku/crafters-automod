# Misskey URL reachable over both HTTP API and WebSocket.
# Default: reach Misskey at 127.0.0.1:13000 from the same host.
# Change the URL if your Misskey listener uses a different address or port.
# In Docker, use a shared-network service URL or your public HTTPS URL.
# Container-local 127.0.0.1 refers to Automod, not the host's Misskey.
MISSKEY_URL=http://127.0.0.1:13000
MISSKEY_TOKEN=replace-with-a-moderator-token

# Start with dry-run. Enforcing T2 requires a manual role ID.
AUTOMOD_MODE=dry-run
T2_ROLE_ID=
LLM_REVIEW_DELAY_MS=900000

# Append T1/T2/T3 results to each user's Misskey moderation note in enforce mode.
# Requires read:admin:show-user and write:admin:user-note. Dry-run never writes.
MODERATION_NOTE_ENABLED=true
# Human-readable log language: ja or en.
MODERATION_NOTE_LANGUAGE=ja

# Small deployments: built-in SQLite, one process, no extra DB server.
AUTOMOD_BACKEND=sqlite
AUTOMOD_ROLE=all
AUTOMOD_DATA_DIR=data
WORKER_CONCURRENCY=1

# Large deployments: PostgreSQL with all/ingest/worker roles.
# Use a dedicated Automod database, separate from Misskey's database.
# AUTOMOD_BACKEND=postgres
# AUTOMOD_DATABASE_URL=postgresql://automod:replace-password@postgres:5432/automod
# AUTOMOD_ROLE=worker
# WORKER_CONCURRENCY=4
# All processes for one Misskey instance must share the same namespace.
# If unset, the namespace is derived from MISSKEY_URL.
# AUTOMOD_NAMESPACE=misskey-production

# Maximum pending/running/dead inbox jobs.
# Completed note IDs are retained for deduplication.
MAX_INBOX_JOBS=100000
# Limit each LLM review and historical purge queue separately.
# Their consumers are not connected yet.
MAX_QUEUED_JOBS=100000
# Maximum in-memory writes awaiting persistence.
# Overflow or a write failure stops ingestion.
MAX_PENDING_NOTES=1000
WORK_MAX_ATTEMPTS=5
WORK_LEASE_MS=60000
WORKER_POLL_MS=250
WORK_RETRY_BASE_MS=1000
WORK_RETRY_MAX_MS=60000

# Minimum shared interval for all Misskey API calls and workers.
# HTTP 429 sets a shared cooldown.
MIN_ACTION_INTERVAL_MS=1100
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787

# Stop Forum Spam: external lookups require explicit opt-in.
# Disabled by default; no identifiers are sent while disabled.
SFS_ENABLED=false
# Verified email only by default. IP checks require administrator access
# and send eligible IP addresses to the external service.
SFS_CHECK_IP=false
# Shared by all workers in this namespace, separate from Misskey's budget.
SFS_MIN_INTERVAL_MS=1100
SFS_MAX_DAILY_REQUESTS=5000
SFS_CACHE_TTL_MS=21600000
SFS_FAILURE_TTL_MS=300000
