# Misskey HTTP API / WebSocketへ到達できるURL。
# 同居systemd: http://127.0.0.1:3000 / Dockerの127.0.0.1はコンテナ自身です。
MISSKEY_URL=https://misskey.example
MISSKEY_TOKEN=replace-with-a-moderator-token

# 初回はdry-run。T2のenforceには手動ロールIDが必要です。
AUTOMOD_MODE=dry-run
T2_ROLE_ID=
LLM_REVIEW_DELAY_MS=900000

# 小規模の既定: Bun内蔵SQLiteで1プロセス。追加DBサーバー不要。
AUTOMOD_BACKEND=sqlite
AUTOMOD_ROLE=all
AUTOMOD_DATA_DIR=data
WORKER_CONCURRENCY=1

# 大規模: postgres + all/ingest/worker。共有DBはMisskeyのDBから分離します。
# AUTOMOD_BACKEND=postgres
# AUTOMOD_DATABASE_URL=postgresql://automod:replace-password@postgres:5432/automod
# AUTOMOD_ROLE=worker
# WORKER_CONCURRENCY=4
# 同じMisskey向け全プロセスで同じnamespaceを使用。未指定時はMISSKEY_URLから生成。
# AUTOMOD_NAMESPACE=misskey-production

# 完了前の受信ジョブ(pending/running/dead)の上限。完了IDは重複防止用に保持。
MAX_INBOX_JOBS=100000
# LLM監査/過去投稿削除それぞれのキュー上限（両ワーカーは未接続）。
MAX_QUEUED_JOBS=100000
# DBへの保存待ち件数のメモリ上限。超過/保存失敗は受信プロセスを停止。
MAX_PENDING_NOTES=1000
WORK_MAX_ATTEMPTS=5
WORK_LEASE_MS=60000
WORKER_POLL_MS=250
WORK_RETRY_BASE_MS=1000
WORK_RETRY_MAX_MS=60000

# 全API・全ワーカーで共有する最小リクエスト間隔。429は共有クールダウン。
MIN_ACTION_INTERVAL_MS=1100
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8787

# Stop Forum Spam: 外部照会は明示的な有効化が必要。既定は送信なし。
SFS_ENABLED=false
# 確認済みメールのみが既定。IP照会は管理者権限と追加の外部送信を伴います。
SFS_CHECK_IP=false
# Misskey APIとは別枠で、同じnamespaceの全ワーカーで共有します。
SFS_MIN_INTERVAL_MS=1100
SFS_MAX_DAILY_REQUESTS=5000
SFS_CACHE_TTL_MS=21600000
SFS_FAILURE_TTL_MS=300000
