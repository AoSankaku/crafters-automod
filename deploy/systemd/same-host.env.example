# Run Automod as a separate systemd service on the same host as Misskey.
# Change this URL if your Misskey listener uses a different address or port.
MISSKEY_URL=http://127.0.0.1:13000
MISSKEY_TOKEN=replace-with-a-moderator-token
AUTOMOD_MODE=dry-run
T2_ROLE_ID=

AUTOMOD_DATA_DIR=/var/lib/crafters-automod
LLM_REVIEW_DELAY_MS=900000
MAX_QUEUED_JOBS=100000
MAX_PENDING_NOTES=1000
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787

# Durable standalone queue; no additional database server is needed.
AUTOMOD_BACKEND=sqlite
AUTOMOD_ROLE=all
WORKER_CONCURRENCY=1
MAX_INBOX_JOBS=100000
WORK_MAX_ATTEMPTS=5
WORK_LEASE_MS=60000
MIN_ACTION_INTERVAL_MS=1100
