# Misskey とは別の Linux ホストで、専用 systemd サービスとして実行する例。
# HTTPS と WebSocket の両方が使える Misskey の URL に変更してください。
MISSKEY_URL=https://misskey.example
MISSKEY_TOKEN=replace-with-a-moderator-token
AUTOMOD_MODE=dry-run
T2_ROLE_ID=

AUTOMOD_DATA_DIR=/var/lib/crafters-automod
LLM_REVIEW_DELAY_MS=900000
MAX_QUEUED_JOBS=100000
MAX_PENDING_NOTES=1000
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8787

# 別ホスト単体の既定。同じSQLiteを複数ホストで共有しないでください。
AUTOMOD_BACKEND=sqlite
AUTOMOD_ROLE=all
WORKER_CONCURRENCY=1
MAX_INBOX_JOBS=100000
WORK_MAX_ATTEMPTS=5
WORK_LEASE_MS=60000
MIN_ACTION_INTERVAL_MS=1100

# 分散する場合はdocs/deployment.mdに従い、全プロセスで同じDB/namespaceを設定。
# AUTOMOD_BACKEND=postgres
# AUTOMOD_DATABASE_URL=postgresql://automod:replace-password@db.internal:5432/automod
# AUTOMOD_NAMESPACE=misskey-production
# AUTOMOD_ROLE=worker
# WORKER_CONCURRENCY=4
