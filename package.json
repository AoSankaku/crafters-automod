{
  "name": "crafters-automod",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "imports": {
    "#test": {
      "bun": "bun:test",
      "default": "./test/support/vitest.js"
    }
  },
  "scripts": {
    "rules:check": "node ./scripts/check-rules.js",
    "build": "node ./scripts/build.js",
    "start": "node ./dist/index.js",
    "dev": "node ./src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "override": "node ./dist/cli.js override",
    "migrate": "node ./dist/cli.js migrate",
    "status": "node ./dist/cli.js status",
    "rules:check:bun": "bun ./scripts/check-rules.js",
    "build:bun": "bun ./scripts/build.js",
    "start:bun": "bun ./dist/index.js",
    "dev:bun": "bun ./src/index.js",
    "test:bun": "bun test",
    "test:coverage:bun": "bun test --coverage",
    "override:bun": "bun ./dist/cli.js override",
    "migrate:bun": "bun ./dist/cli.js migrate",
    "status:bun": "bun ./dist/cli.js status"
  },
  "dependencies": {
    "postgres": "4.1.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "vitest": "5.1.0"
  }
}
